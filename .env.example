# Copy to .env.local. `npm run setup` fills any value left blank here from the
# local Supabase stack — it never overwrites a value you have already set.

# --- Supabase ---
# Local defaults (see supabase/config.toml): http://127.0.0.1:54351
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Drizzle) ---
# Local default: postgresql://postgres:postgres@127.0.0.1:54352/postgres
# In production, migrations and dumps use the SESSION pooler
# (...pooler.supabase.com:5432, IPv4); the Vercel runtime uses the
# TRANSACTION pooler (:6543). The direct connection (db.<ref>.supabase.co)
# is IPv6-only and unreachable from GitHub runners. See the fuller note
# near the bottom of this file.
DATABASE_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Chasing (slice 10) ---
# Shared secret the drain route (/api/chase/drain) requires in its
# Authorization header. Any string >= 16 chars. Required for the drain route.
CHASE_DRAIN_SECRET=
# --- Scheduling reminders (S2) ---
# Shared secret the booking-reminder drain route (/api/scheduling/drain)
# requires in its Authorization header. Any string >= 16 chars. Required
# for the drain route.
SCHEDULING_DRAIN_SECRET=
# Optional — a dev default exists (Booklo <chase@localhost>).
EMAIL_FROM=
# Production only. Leave empty locally — SMTP (below) is used instead.
RESEND_API_KEY=
# Local Mailpit (see supabase/config.toml).
SMTP_HOST=127.0.0.1
SMTP_PORT=54355

# --- Billing (spec 2026-08-18) ---
# "fake" (default; dev checkout at /dev/billing/checkout) or "stripe".
BILLING_PROVIDER=fake
# HMAC secret the fake provider signs its webhooks with (tests + dev). >= 16 chars.
BILLING_FAKE_SECRET=
# Stripe (Managed Payments). Production only. With APP_ENV=production and
# BILLING_PROVIDER=stripe all six are required (src/env-schema.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
# Founder price: Stripe promotion code id, applied for orgs created before the cutoff (YYYY-MM-DD).
BILLING_FOUNDER_PROMO_CODE=
BILLING_FOUNDER_CUTOFF=

# --- Internal utils (owner-only, spec 2026-08-18-internal-utils) ---
# Comma-separated emails allowed into /utils on THIS environment. Leave empty
# to lock /utils for everyone (it 404s). Set it on stage/prod at deploy time.
# Load-bearing in production: omit it and you are locked out of the back
# office on the deployment that needs it.
INTERNAL_EMAILS=

# --- Production only (spec 2026-08-19-launch-infrastructure) ---
# Set ONLY in the Vercel project. Its presence switches on the required-var
# checks in src/env.ts. Never set it locally or in CI.
# APP_ENV=production
#
# NOTE ON DATABASE_URL: production uses TWO different values.
#   Vercel runtime  -> transaction pooler, ...pooler.supabase.com:6543
#   GitHub Actions  -> session pooler,     ...pooler.supabase.com:5432
# The direct connection (db.<ref>.supabase.co:5432) is IPv6-only and is
# unreachable from GitHub-hosted runners.
