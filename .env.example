# Copy to .env.local. `npm run setup` fills any value left blank here from the
# local Supabase stack — it never overwrites a value you have already set.

# --- Supabase ---
# Local defaults (see supabase/config.toml): http://127.0.0.1:54351
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Drizzle) ---
# Local default: postgresql://postgres:postgres@127.0.0.1:54352/postgres
# In production use the direct (5432) URL for migrations, not the pooler —
# transaction-mode pooling cannot run DDL reliably.
DATABASE_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Chasing (slice 10) ---
# Shared secret the drain route (/api/chase/drain) requires in its
# Authorization header. Any string >= 16 chars. Required for the drain route.
CHASE_DRAIN_SECRET=
# --- Scheduling reminders (S2) ---
# Shared secret the booking-reminder drain route (/api/scheduling/drain)
# requires in its Authorization header. Any string >= 16 chars. Required
# for the drain route.
SCHEDULING_DRAIN_SECRET=
# Optional — a dev default exists (Booklo <chase@localhost>).
EMAIL_FROM=
# Production only. Leave empty locally — SMTP (below) is used instead.
RESEND_API_KEY=
# Local Mailpit (see supabase/config.toml).
SMTP_HOST=127.0.0.1
SMTP_PORT=54355

# --- Billing (spec 2026-08-18) ---
# "fake" (default) or "stripe". The fake provider is a full emulator, not a
# shortcut: checkout goes to /dev/billing/checkout and "Manage subscription"
# to /dev/billing/portal — dev-only pages (non-production, BILLING_PROVIDER
# != stripe, BILLING_ENABLED, signed-in member of the org) whose buttons emit
# the same BillingEvents Stripe's webhooks would and apply them through the
# same projection. Test cards on the checkout page:
#   4242 4242 4242 4242  -> succeeds
#   4000 0000 0000 0002  -> declined
#   4000 0000 0000 9995  -> insufficient funds
#   4000 0000 0000 0341  -> card attached, first charge fails (born past_due)
# Any other Luhn-valid 16-digit number succeeds; expiry must be a future
# MM/YY and the CVC 3-4 digits.
BILLING_PROVIDER=fake
# HMAC secret the fake provider signs its webhooks with (tests + dev). >= 16 chars.
BILLING_FAKE_SECRET=
# Stripe (Managed Payments). Production only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=
# Founder price: Stripe promotion code id, applied for orgs created before the cutoff (YYYY-MM-DD).
BILLING_FOUNDER_PROMO_CODE=
BILLING_FOUNDER_CUTOFF=
